{
  "name": "hong-blog",
  "description": "A text-first Astro blog theme with command-palette search and a light/dark reading mode.",
  "type": "module",
  "version": "1.0.0",
  "author": "Hong Huang",
  "license": "MIT",
  "private": true,
  "keywords": [
    "astro-theme",
    "astro",
    "blog",
    "minimal",
    "editorial",
    "writing",
    "tailwindcss"
  ],
  "homepage": "https://honghuang.foomansoft.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/BBC6BAE9/blog.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run build --prefix portfolio && node scripts/merge-portfolio.mjs",
    "check": "astro check && npm run check --prefix portfolio",
    "release:check": "npm run check && npm run build && npm run format:check",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new-post": "node scripts/new-post.mjs",
    "dev:portfolio": "npm run dev --prefix portfolio"
  },
  "overrides": {
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^22.16.5",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vite": "^8.1.5"
  }
}
