---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE, NAV_LINKS } from '@/site.config';
import { withBase } from '@/utils/urls';

const currentPath = Astro.url.pathname;
---

<header class="border-line bg-paper/90 sticky top-0 z-40 border-b backdrop-blur">
  <div
    class="mx-auto flex max-w-3xl flex-col items-start justify-between gap-3 px-6 py-4 sm:flex-row sm:items-center"
  >
    <a
      href={withBase('/')}
      class="font-display text-ink shrink-0 text-lg font-medium whitespace-nowrap"
    >
      {SITE.name}
    </a>

    <nav class="flex w-full items-center gap-5 sm:w-auto" aria-label="Primary">
      {
        NAV_LINKS.map((link) => {
          const href = withBase(link.href);
          const isActive = !link.reload && (currentPath === href || currentPath.startsWith(href));
          return (
            <a
              href={href}
              data-astro-reload={link.reload ? true : undefined}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'font-mono text-xs tracking-wide uppercase transition-colors',
                isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        href={withBase('/#contact')}
        class="text-ink-soft hover:text-ink hidden font-mono text-xs tracking-wide uppercase transition-colors sm:inline"
      >
        Contact
      </a>
      <span class="ml-auto flex sm:ml-0"><ThemeToggle /></span>
    </nav>
  </div>
</header>
