---
import { SITE } from '@/site.config';

const year = new Date().getFullYear();
---

<footer class="border-line border-t">
  <div
    class="text-ink-soft mx-auto flex max-w-3xl flex-col gap-4 px-6 py-8 font-mono text-xs sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="leading-relaxed">
      © {year} · {SITE.name}. Built with Astro.<br />
      Theme by <a
        href="https://github.com/BracoZS/astro-starter-portfolio"
        class="hover:text-signal transition-colors">BracoZS</a
      >.
    </p>

    <nav class="flex flex-wrap items-center gap-4" aria-label="Social">
      {
        SITE.social.map((link) => (
          <a href={link.href} class="hover:text-signal transition-colors" rel="me">
            {link.label}
          </a>
        ))
      }
      <a href="#top" class="hover:text-signal transition-colors"> Top ↑ </a>
    </nav>
  </div>
</footer>
