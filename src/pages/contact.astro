---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout title="联系我" description="通过邮件、GitHub 或 X 联系 Hong Huang。">
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">联系</p>
        <h1 class="pagehead-title">聊聊你的想法</h1>
        <p class="pagehead-description">文章勘误、技术交流、开源项目反馈，欢迎联系。</p>
      </header>
      <div class="prose">
        <h2>邮件</h2>
        <p>可以直接写信到 <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>。如果是文章反馈，请附上文章链接和相关信息，方便我了解问题。</p>
        <h2>GitHub</h2>
        <p>开源项目相关的问题，欢迎在对应仓库提交 Issue，方便其他使用者一起讨论。</p>
        <p><a href="https://github.com/BBC6BAE9">github.com/BBC6BAE9</a></p>
        <h2>X</h2>
        <p><a href="https://x.com/Bae9Bbc6">@Bae9Bbc6</a></p>
      </div>
      <a href={`mailto:${siteConfig.email}`} class="btn btn-solid mt-8">给我发邮件</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
