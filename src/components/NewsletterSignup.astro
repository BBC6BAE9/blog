---
import { siteConfig } from "@/config/site";
import { withBase } from "@/lib/urls";
import { defaultLocale, getMessages, localizedPath, type Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? defaultLocale;
const copy = getMessages(locale).newsletter;
const newsletter = siteConfig.newsletter;
const action = newsletter.action.trim();
const canSubscribe = newsletter.enabled && action.length > 0;
---

<section id="newsletter" aria-labelledby="newsletter-heading">
  <h3 id="newsletter-heading" class="text-base font-semibold tracking-tight">{copy.heading}</h3>
  <p class="mt-2 text-pretty text-sm leading-relaxed text-muted-foreground">{copy.intro}</p>
  <a href={withBase(localizedPath(locale, "/rss.xml"))} class="btn btn-outline btn-block mt-5">{copy.rss}</a>
  {canSubscribe ? (
    <form class="mt-5 grid gap-3" action={action} method={newsletter.method}>
      <p class="text-sm leading-relaxed text-muted-foreground">{copy.description}</p>
      <label class="sr-only" for="newsletter-email">{copy.emailLabel}</label>
      <input id="newsletter-email" required type="email" name={newsletter.emailFieldName} autocomplete="email" placeholder={copy.emailPlaceholder} class="field" />
      <button type="submit" class="btn btn-solid btn-block">{copy.submit}</button>
      <p class="text-xs leading-relaxed text-muted-foreground">{copy.privacy}</p>
      <a class="text-xs text-muted-foreground link-sweep" href="https://follow.it" target="_blank" rel="noopener noreferrer">Powered by follow.it</a>
    </form>
  ) : (
    <p class="mt-3 text-xs leading-relaxed text-muted-foreground">{copy.comingSoon}</p>
  )}
</section>
