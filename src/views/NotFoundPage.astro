---
import { withBase } from "@/lib/urls";
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMessages, localizedPath, type Locale } from "@/i18n";
import { visiblePosts } from "@/lib/posts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getMessages(locale).notFound;
const allPosts = visiblePosts(await getCollection("posts"), locale);
---

<BaseLayout locale={locale} title={copy.title} description={copy.description} noindex>
  <SiteHeader posts={allPosts} locale={locale} />
  <main id="content" class="outer grid min-h-[55vh] place-items-center py-16 text-center">
    <div>
      <p class="eyebrow">404</p>
      <h1 class="pagehead-title">{copy.title}</h1>
      <p class="pagehead-description mx-auto">{copy.intro}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={withBase(localizedPath(locale, "/"))} class="btn btn-solid">{copy.home}</a>
        <a href={withBase(localizedPath(locale, "/posts/"))} class="btn btn-outline">{copy.posts}</a>
      </div>
    </div>
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>
