---
import { withBase } from "@/lib/urls";
import { getCollection } from "astro:content";
import type { Page } from "astro";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMessages, type Locale } from "@/i18n";
import { visiblePosts, type Post } from "@/lib/posts";

interface Props {
  locale: Locale;
  page: Page<Post>;
}

const { locale, page } = Astro.props;
const copy = getMessages(locale).archive;
const allPosts = visiblePosts(await getCollection("posts"), locale);
const title = copy.pageTitle(page.currentPage);
const withTrailingSlash = (url: string | undefined) => (url && !url.endsWith("/") ? `${url}/` : url);
const prevUrl = withTrailingSlash(page.url.prev);
const nextUrl = withTrailingSlash(page.url.next);
---

<BaseLayout locale={locale} title={title} description={copy.description} prevUrl={prevUrl} nextUrl={nextUrl}>
  <SiteHeader posts={allPosts} locale={locale} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1 class="pagehead-title">{copy.title}</h1>
        <p class="pagehead-description">{copy.summary(page.total)}</p>
      </header>

      <div class="feed">
        {page.data.map((post) => <PostCard post={post} locale={locale} />)}
      </div>

      <nav class="mt-16 flex items-center justify-between gap-4 border-t border-border pt-6" aria-label={copy.pagination}>
        {prevUrl ? (
          <a href={withBase(prevUrl)} class="nav-link link-nudge">
            <span class="link-nudge__arrow link-nudge__arrow--prev">&larr;</span> {copy.newer}
          </a>
        ) : (
          <span class="nav-link opacity-40">&larr; {copy.newer}</span>
        )}
        <span class="text-xs tracking-widest text-muted-foreground uppercase">
          {copy.page(page.currentPage, page.lastPage)}
        </span>
        {nextUrl ? (
          <a href={withBase(nextUrl)} class="nav-link link-nudge">
            {copy.older} <span class="link-nudge__arrow link-nudge__arrow--next">&rarr;</span>
          </a>
        ) : (
          <span class="nav-link opacity-40">{copy.older} &rarr;</span>
        )}
      </nav>
    </div>
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>
